# Required on every setup, verify, and serve invocation.
SOI_MINT_URL=https://your-mint.example
SOI_PAYOUT_THRESHOLD_SATS=100000

# Required for a fresh database. Omit either to reuse that value from the last active identity.
SOI_USERNAME=alice
SOI_XPUB=YOUR_ACCOUNT_XPUB_OR_ZPUB

# Optional runtime settings. Use 0.0.0.0 behind a container/Fly HTTPS proxy.
SOI_DATABASE=./data/sats-on-ice.sqlite
SOI_HOSTNAME=127.0.0.1
SOI_PORT=3000

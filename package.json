{
  "name": "sats-on-ice",
  "version": "0.1.0",
  "description": "Self-hosted Lightning Address to Cashu to Bitcoin payouts",
  "license": "MIT",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "cli": "bun run index.ts",
    "build": "bun build ./index.ts --target=bun --outdir=dist && bun run scripts/copy-migrations.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate"
  },
  "devDependencies": {
    "@cashu/cashu-ts": "5.0.0-rc.4",
    "@getalby/lightning-tools": "9.0.1",
    "@types/bun": "1.3.14",
    "bolt11": "1.4.1",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@cashu/coco-core": "2.0.0",
    "@cashu/coco-sqlite-bun": "2.0.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "@scure/btc-signer": "2.4.1",
    "commander": "15.0.0",
    "drizzle-orm": "0.45.2",
    "light-bolt11-decoder": "3.2.0",
    "zod": "4.6.5"
  }
}
